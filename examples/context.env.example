# cfctx context.env — TEMPLATE
#
# Copy this into a context with:
#   cfctx init-env <name>          # stamps a fresh template
#   cfctx edit <name>               # opens $EDITOR on the file
#
# The real file lives at $CFCTX_ROOT/<name>/context.env (mode 0600) and
# is sourced into the current shell on every `cfctx <name>` switch.
#
# Storing plaintext secrets is acceptable because the file is 0600 in
# your home directory, but if your org requires stricter handling you
# can shell out to a secret manager. Examples:
#
#   export OM_PASSWORD="$(security find-generic-password -s om-tdc -w)"
#   export BOSH_CLIENT_SECRET="$(pass show tanzu/tdc/bosh-client-secret)"
#   export OM_CLIENT_SECRET="$(op read 'op://Private/om-tdc/credential')"

# ---------------------------------------------------------------------------
# CF CLI
# ---------------------------------------------------------------------------
# The CF CLI itself is driven by $CF_HOME, which cfctx sets for you. These
# variables are purely for your own scripts (cf login -a "$CF_API", etc.).
# export CF_API="https://api.sys.tas-tdc.kuhn-labs.com"
# export CF_ORG="system"
# export CF_SPACE="system"
# export CF_USERNAME="admin"
# export CF_PASSWORD=""

# ---------------------------------------------------------------------------
# Ops Manager (om CLI)
# ---------------------------------------------------------------------------
# export OM_TARGET="https://opsmgr.tas-tdc.kuhn-labs.com"
# export OM_USERNAME="admin"
# export OM_PASSWORD=""
# export OM_SKIP_SSL_VALIDATION="true"
#
# Prefer client credentials over username/password when the foundation
# has a UAA client provisioned for automation:
# export OM_CLIENT_ID=""
# export OM_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# BOSH Director
# ---------------------------------------------------------------------------
# Populate these manually, OR let `cfctx bosh-env` (planned v0.4) fill them
# in from `om bosh-env` on first use.
# export BOSH_ENVIRONMENT="10.0.0.10"
# export BOSH_CLIENT="ops_manager"
# export BOSH_CLIENT_SECRET=""
# export BOSH_CA_CERT=""
# export BOSH_GW_HOST=""
# export BOSH_GW_USER="jumpbox"
# export BOSH_GW_PRIVATE_KEY="$HOME/.ssh/jumpbox_tdc"

# ---------------------------------------------------------------------------
# CredHub
# ---------------------------------------------------------------------------
# export CREDHUB_SERVER="https://credhub.tas-tdc.kuhn-labs.com:8844"
# export CREDHUB_CLIENT="credhub_admin_client"
# export CREDHUB_SECRET=""
# export CREDHUB_CA_CERT=""

# --- SSO / auth mode (added for external-IdP foundations) ---
# CF_AUTH_MODE: auto (default) | sso | client | password
#   auto    → dispatcher picks: automation+client-id → client; else SSO-capable → sso; else password
#   sso     → human one-time passcode (cf login --sso)
#   client  → UAA client_credentials (CI / service accounts / agents); never prompts
#   password→ legacy cf auth <user> <pass>
# export CF_AUTH_MODE="auto"
# CF UAA *service client* for automation (distinct from UAA_ADMIN_CLIENT and CF_USERNAME):
# export CF_UAA_CLIENT_ID="cfctx-automation"
# export CF_UAA_CLIENT_SECRET="..."
# Seeded by `cfctx enrich`; 1 when the CF UAA fronts an external IdP:
# export CF_SSO_CAPABLE="0"
